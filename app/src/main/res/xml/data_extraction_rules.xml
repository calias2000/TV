<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing the app stores leaves the TV, by cloud backup or by device transfer (a profile can hold a provider URL with the account in it). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
