<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Declares this is a TV app. Without it the app is not offered on Android TV. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <!-- A TV has no touchscreen, so this must not be required. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Plain http streams are allowed on purpose: the reason is in res/xml/network_security_config.xml. -->
    <!-- enableOnBackInvokedCallback: Android 13+ hands BACK to the app through the platform back dispatcher. -->
    <application
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:label="TV"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER puts the app on the TV home screen row. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
