<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The app updates itself from GitHub Releases (see update/UpdateViewModel). Installing needs this one, which the user allows per app
         ("Install unknown apps"); the second lets Android 12+ skip its confirmation when an app updates itself, where the system allows it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Declares this is a TV app. Without it the app is not offered on Android TV. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <!-- A TV has no touchscreen, so this must not be required. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Plain http streams are allowed on purpose: the reason is in res/xml/network_security_config.xml. -->
    <!-- enableOnBackInvokedCallback: Android 13+ hands BACK to the app through the platform back dispatcher. -->
    <!-- Backup is off: a profile can hold a provider URL with the account in it. The rules files exclude everything: from Android 12 they are what count
         (allowBackup alone may still let a device transfer through). A new TV is a new setup. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:label="TV"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER puts the app on the TV home screen row. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
